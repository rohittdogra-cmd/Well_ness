# Public Supabase credentials for the wellness hub.
# Copy to .env.local and fill in from Supabase → Project Settings → API.
# Both values are safe to expose to the browser: row-level security in Postgres
# is what authorizes every read and write. Never add a service-role key here.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=YOUR-PUBLISHABLE-KEY

# Canonical origin used for metadata, canonical URLs, Open Graph and sitemap.xml.
# Set this on Vercel to your production domain so previews do not advertise
# themselves as canonical. Leave unset locally.
# NEXT_PUBLIC_SITE_URL=https://wellness.example.com